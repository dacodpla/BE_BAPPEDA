# Server
PORT=3000
NODE_ENV=development

# Frontend origin (used by CORS; must be the exact URL the browser loads)
CLIENT_URL=http://localhost:5173

# JWT signing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Auth cookie
AUTH_COOKIE_NAME=sipedis_session
# In production set true so the cookie is only sent over HTTPS
AUTH_COOKIE_SECURE=false
# One of: strict | lax | none
AUTH_COOKIE_SAMESITE=lax

# Rate limiting (applied to /auth routes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# SQLite database file (created on first run; ':memory:' for throwaway runs)
DB_FILE=./data/sipedis.db

# Uploaded supporting documents
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=5
UPLOAD_MAX_FILES=10

# Travel policy
# Province of the BAPPEDA office; destinations here use the in-province rate
HOME_PROVINCE=Jawa Barat
POLICY_MAX_TRIP_DAYS=14
