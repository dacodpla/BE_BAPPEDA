# Server
PORT=3000
NODE_ENV=development

# Frontend origin (used by CORS; must be the exact URL the browser loads)
CLIENT_URL=http://localhost:5173

# JWT signing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Auth cookie
AUTH_COOKIE_NAME=sipedis_session
# In production set true so the cookie is only sent over HTTPS
AUTH_COOKIE_SECURE=false
# One of: strict | lax | none
AUTH_COOKIE_SAMESITE=lax

# Rate limiting (applied to /auth routes)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
